# =============================================================================
# CAURIS DIGITAL — Variables d'environnement
# -----------------------------------------------------------------------------
# Copiez ce fichier en `.env.local` (qui n'est PAS committé sur Git)
# et remplissez vos vraies valeurs.
# =============================================================================

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://caurisdigital.org

# -----------------------------------------------------------------------------
# Email transactionnel — Resend (https://resend.com)
# -----------------------------------------------------------------------------
# 1. Créer un compte gratuit sur https://resend.com (100 emails/jour gratuits)
# 2. Récupérer une clé API : https://resend.com/api-keys
# 3. (Optionnel) Vérifier le domaine d'envoi sur https://resend.com/domains
#
# 💡 Pour tester rapidement SANS domaine vérifié, Resend fournit l'adresse
#    "onboarding@resend.dev" — les emails de test arrivent dans la boîte
#    de l'email avec lequel le compte Resend a été créé.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Adresse expéditrice — doit être vérifiée sur Resend (ou onboarding@resend.dev en dev)
CONTACT_EMAIL_FROM=CAURIS DIGITAL <noreply@caurisdigital.org>
# Adresse destinataire des messages reçus via le formulaire
CONTACT_EMAIL_TO=hello@caurisdigital.org

# -----------------------------------------------------------------------------
# Newsletter — Resend Audiences (réutilise RESEND_API_KEY ci-dessus)
# -----------------------------------------------------------------------------
# 1. Aller sur https://resend.com/audiences
# 2. Cliquer sur "Create Audience" → nom : "CAURIS Newsletter"
# 3. Copier l'ID de l'audience (visible dans l'URL : /audiences/XXXX-XXXX-XXXX)
# -----------------------------------------------------------------------------
RESEND_AUDIENCE_ID=

# Secret de signature des liens de confirmation / désinscription newsletter
# (double opt-in — CDC §6.5). Chaîne aléatoire longue, ex : openssl rand -hex 32
# En dev, un secret de repli non sécurisé est utilisé si cette variable est vide —
# à définir obligatoirement en production.
NEWSLETTER_TOKEN_SECRET=

# (Anciens placeholders Mailchimp / Brevo — non utilisés si on reste sur Resend)
# NEWSLETTER_API_KEY=
# NEWSLETTER_LIST_ID=

# -----------------------------------------------------------------------------
# reCAPTCHA v3 — anti-bot sur le formulaire contact
# https://www.google.com/recaptcha/admin/create
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# -----------------------------------------------------------------------------
# Google Analytics 4 — suivi des visites (CDC §8.4)
# -----------------------------------------------------------------------------
# 1. Créer une propriété GA4 sur https://analytics.google.com (gratuit)
# 2. Récupérer le Measurement ID (format : G-XXXXXXXXXX)
#
# 💡 RGPD : GA4 ne se charge QUE si l'utilisateur a accepté les cookies
#    via le bandeau (CookieBanner). Anonymisation IP activée automatiquement.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Base de données — PostgreSQL via Supabase (CDC V2 §5.1, §10.3)
# -----------------------------------------------------------------------------
# 1. Créer un projet sur https://supabase.com (gratuit, 500 Mo)
# 2. Bouton "Connect" → onglet "ORMs"/"Prisma" → copier les deux chaînes
# 3. Remplacer [YOUR-PASSWORD] par le mot de passe de la base (Settings → Database)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# -----------------------------------------------------------------------------
# Authentification — NextAuth.js v5 (CDC V2 §7.1, §10.3)
# -----------------------------------------------------------------------------
# AUTH_SECRET : chaîne aléatoire 32+ caractères, ex : openssl rand -hex 32
# AUTH_URL : URL de base de l'app (http://localhost:3000 en dev, l'URL Vercel en prod)
# -----------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Seed du premier compte ADMIN (npm run db:seed) — CDC V2 §11.3
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# CMS headless — Sanity.io (à activer en phase 2)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=
