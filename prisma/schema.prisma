generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums — CDC V2 §5.3
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
}

enum Sector {
  AGRITECH
  FINTECH
  EDTECH
  HEALTHTECH
  SMART_CITIES
}

enum StartupStatus {
  EN_INCUBATION
  DIPLOMEE
  ALUMNI
}

enum ArticleCategory {
  ANNONCES
  PORTRAITS
  RESSOURCES
  EVENEMENTS
  OPINIONS
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventType {
  DEMO_DAY
  ATELIER
  WEBINAIRE
  HACKATHON
  NETWORKING
  CONFERENCE
}

enum PartnerCategory {
  INSTITUTIONNEL
  FINANCIER
  ACADEMIQUE
  CORPORATIF
}

enum ContactMessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

// ---------------------------------------------------------------------------
// User — CDC V2 §5.3.1 (comptes administrateurs et éditeurs)
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String
  role                Role      @default(EDITOR)
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  // Rate limiting connexion — CDC V2 RM-U05 (5 échecs -> blocage 15 min)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  articles Article[]
  startups Startup[]
  events   Event[]
  partners Partner[]
  sessions Session[]

  @@map("users")
}

// NextAuth.js v5 — stratégie de session en base de données (CDC §7.1).
// Pas d'Account/VerificationToken : seul le Credentials Provider est utilisé (pas d'OAuth).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Startup — CDC V2 §5.3.2
// ---------------------------------------------------------------------------

model Startup {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  tagline         String
  description     String        @db.Text
  longDescription String?       @db.Text
  sector          Sector
  countryName     String
  countryCode     String        @db.VarChar(2)
  city            String?
  status          StartupStatus
  year            Int
  foundedYear     Int?
  logoUrl         String?
  websiteUrl      String?
  linkedinUrl     String?
  technologies    String[]      @default([])
  founders        String[]      @default([])
  metrics         Json?
  achievements    String[]      @default([])
  isFeatured      Boolean       @default(false)
  createdBy       String?
  creator         User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, sector])
  @@map("startups")
}

// ---------------------------------------------------------------------------
// Article — CDC V2 §5.3.3
// ---------------------------------------------------------------------------

model Article {
  id            String          @id @default(cuid())
  slug          String          @unique
  title         String
  excerpt       String
  content       String          @db.Text
  category      ArticleCategory
  coverImageUrl String?
  readingTime   Int
  status        ArticleStatus   @default(DRAFT)
  publishedAt   DateTime?
  authorId      String
  author        User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([authorId])
  @@map("articles")
}

// ---------------------------------------------------------------------------
// Event — CDC V2 §5.3.4
// ---------------------------------------------------------------------------

model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String    @db.Text
  type        EventType
  startDate   DateTime
  endDate     DateTime?
  location    String
  isOnline    Boolean   @default(false)
  isFree      Boolean   @default(true)
  price       String?
  registerUrl String?
  imageUrl    String?
  isPublished Boolean   @default(false)
  createdBy   String?
  creator     User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startDate(sort: Desc)])
  @@map("events")
}

// ---------------------------------------------------------------------------
// Partner — CDC V2 §5.3.5
// ---------------------------------------------------------------------------

model Partner {
  id           String          @id @default(cuid())
  name         String
  logoUrl      String?
  websiteUrl   String?
  category     PartnerCategory
  displayOrder Int             @default(0)
  isFeatured   Boolean         @default(false)
  createdBy    String?
  creator      User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("partners")
}

// ---------------------------------------------------------------------------
// ContactMessage — CDC V2 §5.3.6
// ---------------------------------------------------------------------------

model ContactMessage {
  id             String               @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  country        String?
  subject        String
  message        String               @db.Text
  status         ContactMessageStatus @default(UNREAD)
  ipAddress      String?
  recaptchaScore Float?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([createdAt(sort: Desc), status])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// NewsletterSubscriber — CDC V2 §5.3.7 (inclut consentGiven/consentDate RGPD)
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  firstName      String?
  status         SubscriberStatus @default(ACTIVE)
  source         String?
  unsubscribedAt DateTime?
  consentGiven   Boolean          @default(false)
  consentDate    DateTime?
  createdAt      DateTime         @default(now())

  @@map("newsletter_subscribers")
}
